# Local Claude Code overrides (never commit personal/local settings).
# The shared, auditable allowlist `.claude/settings.json` IS committed;
# `.claude/settings.local.json` (personal overrides) is not.
.claude/settings.local.json

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Build / packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Coverage / test artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node (only static HTML is committed under site/)
node_modules/

# Secrets and credentials (never commit)
.env
.env.*
*.key
*.pem
secrets.*

# Model weights / large generated artifacts
*.bin
*.pt
*.onnx
*.gguf
*.safetensors
*.h5
*.ckpt
*.parquet

# LLM adapter response caches (recorded fixtures under data/ are committed;
# runtime caches under results/ are not)
results/cache/
*.cache.json

# Generated run artifacts. Small, curated example runs/reports may be
# force-added by a milestone; everything else stays out of git.
results/runs/
results/processed/
results/figures/
results/reports/

# Logs and pids
logs/
*.log
*.pid

# OS / editor cruft
.DS_Store
*.swp
*~
